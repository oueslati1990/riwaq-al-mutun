<Window x:Class="MatnMemorization.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MatnMemorization.Presentation.Wpf.ViewModels"
        xmlns:views="clr-namespace:MatnMemorization.Presentation.Wpf.Views"
        xmlns:nav="clr-namespace:MatnMemorization.Presentation.Wpf.Services.Navigation"
        Title="رِواق المتون"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        FlowDirection="RightToLeft"
        FontFamily="Noto Naskh Arabic, Segoe UI, Arial">

    <Window.Resources>
        <!-- Map each ViewModel type to its View -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportViewModel}">
            <views:ImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OcrReviewViewModel}">
            <views:OcrReviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MatnDetailViewModel}">
            <views:MatnDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MemorizationViewModel}">
            <views:MemorizationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReviewViewModel}">
            <views:ReviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <views:StatisticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>

        <!-- Main content area -->
        <ContentControl Grid.Column="0"
                        Content="{Binding NavigationService.CurrentViewModel}"
                        Margin="8" />

        <!-- Sidebar navigation -->
        <Border Grid.Column="1"
                Background="#F5F5F5"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="8" VerticalAlignment="Top">
                <TextBlock Text="رِواق المتون"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="4,8,4,16"
                           TextAlignment="Center" />

                <Button Content="الرئيسية"
                        Command="{Binding NavigateToDashboardCommand}"
                        Margin="4,2" Padding="8,6" />
                <Button Content="مكتبتي"
                        Command="{Binding NavigateToLibraryCommand}"
                        Margin="4,2" Padding="8,6" />
                <Button Content="استيراد متن"
                        Command="{Binding NavigateToImportCommand}"
                        Margin="4,2" Padding="8,6" />
                <Button Content="الإحصاءات"
                        Command="{Binding NavigateToStatisticsCommand}"
                        Margin="4,2" Padding="8,6" />
                <Button Content="الإعدادات"
                        Command="{Binding NavigateToSettingsCommand}"
                        Margin="4,2" Padding="8,6" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
