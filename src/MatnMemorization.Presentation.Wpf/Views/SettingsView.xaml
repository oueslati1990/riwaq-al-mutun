<UserControl x:Class="MatnMemorization.Presentation.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MatnMemorization.Presentation.Wpf.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             FlowDirection="RightToLeft"
             FontFamily="Noto Naskh Arabic, Segoe UI, Arial">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" MaxWidth="600" HorizontalAlignment="Right">

                <TextBlock Text="الإعدادات" FontSize="22" FontWeight="Bold" Margin="0,0,0,24" />

                <!-- Backup section -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#E0E0E0" BorderThickness="1"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="النسخ الاحتياطي" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="13"
                                   Text="احفظ نسخة من بياناتك في ملف يمكنك الاحتفاظ به."
                                   Margin="0,0,0,16" />

                        <Button Content="إنشاء نسخة احتياطية"
                                Command="{Binding BackupCommand}"
                                IsEnabled="{Binding IsBackingUp, Converter={StaticResource InvertBoolConverter}}"
                                HorizontalAlignment="Right"
                                Padding="16,8" FontSize="14"
                                Background="#1565C0" Foreground="White" />

                        <TextBlock Text="{Binding BackupMessage}"
                                   Margin="0,10,0,0" FontSize="13"
                                   Visibility="{Binding BackupMessage, Converter={StaticResource NullToCollapsedConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackupSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="#2E7D32" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BackupSuccess}" Value="False">
                                            <Setter Property="Foreground" Value="#C62828" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Restore section -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#E0E0E0" BorderThickness="1"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="استعادة نسخة احتياطية" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="13"
                                   Margin="0,0,0,4"
                                   Text="استعادة البيانات من نسخة احتياطية سابقة." />
                        <TextBlock TextWrapping="Wrap" Foreground="#B71C1C" FontSize="12"
                                   Text="تحذير: ستُحذف بياناتك الحالية وتُستبدل بالنسخة الاحتياطية."
                                   Margin="0,0,0,16" />

                        <Button Content="استعادة من نسخة احتياطية..."
                                Command="{Binding OpenRestoreConfirmCommand}"
                                IsEnabled="{Binding IsRestoring, Converter={StaticResource InvertBoolConverter}}"
                                HorizontalAlignment="Right"
                                Padding="16,8" FontSize="14"
                                Background="#C62828" Foreground="White" />

                        <TextBlock Text="{Binding RestoreMessage}"
                                   Margin="0,10,0,0" FontSize="13"
                                   Visibility="{Binding RestoreMessage, Converter={StaticResource NullToCollapsedConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RestoreSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="#2E7D32" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RestoreSuccess}" Value="False">
                                            <Setter Property="Foreground" Value="#C62828" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Restore confirm dialog overlay -->
        <Grid Background="#80000000"
              Visibility="{Binding IsRestoreConfirmOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="10"
                    Padding="28,24" MaxWidth="400"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="تأكيد الاستعادة" FontSize="18" FontWeight="Bold"
                               Margin="0,0,0,12" />
                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#444"
                               Margin="0,0,0,8"
                               Text="ستُستبدل بياناتك الحالية بالكامل بمحتوى الملف المختار:" />
                    <TextBlock Text="{Binding PendingRestorePath}"
                               TextWrapping="Wrap" FontSize="12" Foreground="#666"
                               FlowDirection="LeftToRight" Margin="0,0,0,20" />
                    <TextBlock Text="هل أنت متأكد؟ لا يمكن التراجع عن هذه العملية."
                               TextWrapping="Wrap" FontSize="13" Foreground="#C62828"
                               Margin="0,0,0,20" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="تأكيد الاستعادة"
                                Command="{Binding ConfirmRestoreCommand}"
                                Padding="16,8" FontSize="14" Margin="0,0,12,0"
                                Background="#C62828" Foreground="White" />
                        <Button Content="إلغاء"
                                Command="{Binding CancelRestoreCommand}"
                                Padding="16,8" FontSize="14"
                                Background="#EEEEEE" Foreground="#333" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
