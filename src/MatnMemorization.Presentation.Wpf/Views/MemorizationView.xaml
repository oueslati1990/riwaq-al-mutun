<UserControl x:Class="MatnMemorization.Presentation.Wpf.Views.MemorizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MatnMemorization.Presentation.Wpf.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MemorizationViewModel}"
             FlowDirection="RightToLeft"
             FontFamily="Noto Naskh Arabic, Segoe UI, Arial">

    <Grid>
        <!-- No Matn selected -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsNoMatn, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="اختر متناً من المكتبة أولاً"
                       FontSize="20" Foreground="#888"
                       HorizontalAlignment="Center" />
            <TextBlock Text="افتح متناً ثم اضغط 'بدء الحفظ'"
                       FontSize="14" Foreground="#AAA"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Loading -->
        <TextBlock Text="جارٍ التحميل..."
                   FontSize="18" Foreground="#888"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Error -->
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="Red" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}" />

        <!-- Session Complete -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="أحسنت! انتهت الجلسة." FontSize="28" FontWeight="Bold"
                       Foreground="#2E7D32" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding TotalUnits, StringFormat='أتممت {0} بيتاً'}"
                       FontSize="16" Foreground="#555"
                       HorizontalAlignment="Center" Margin="0,8,0,24" />
            <Button Content="بدء جلسة جديدة"
                    Command="{Binding RestartCommand}"
                    HorizontalAlignment="Center"
                    Padding="24,10" FontSize="16"
                    Background="#1565C0" Foreground="White" />
        </StackPanel>

        <!-- Active Session -->
        <Grid Visibility="{Binding IsActiveSession, Converter={StaticResource BoolToVisibilityConverter}}"
              Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Progress row -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0" Height="8"
                             Minimum="0" Maximum="{Binding TotalUnits}"
                             Value="{Binding CurrentUnitNumber, Mode=OneWay}"
                             VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding SessionProgress}"
                           FontSize="14" Foreground="#555"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           FlowDirection="LeftToRight" />
            </Grid>

            <!-- Section title -->
            <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="4"
                    Padding="12,6" Margin="0,0,0,16">
                <TextBlock Text="{Binding CurrentUnit.SectionTitle}"
                           FontSize="14" Foreground="#555" FontStyle="Italic" />
            </Border>

            <!-- Text unit card -->
            <Border Grid.Row="2" Background="White" CornerRadius="8"
                    BorderBrush="#E0E0E0" BorderThickness="1" Padding="24">
                <Grid>
                    <!-- Hidden placeholder -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsTextRevealed, Converter={StaticResource InvertBoolToVisibilityConverter}}">
                        <TextBlock Text="●  ●  ●  ●  ●  ●  ●"
                                   FontSize="32" Foreground="#BDBDBD"
                                   HorizontalAlignment="Center"
                                   FlowDirection="LeftToRight" />
                        <TextBlock Text="اضغط كشف لرؤية البيت"
                                   FontSize="14" Foreground="#9E9E9E"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- Revealed text -->
                    <TextBlock Text="{Binding CurrentUnit.Content}"
                               FontSize="22" TextWrapping="Wrap"
                               LineHeight="38" TextAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsTextRevealed, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Border>

            <!-- Action buttons -->
            <Grid Grid.Row="3" Margin="0,20,0,0">
                <!-- Reveal button (shown when not revealed) -->
                <Button Content="كشف"
                        Command="{Binding RevealCommand}"
                        HorizontalAlignment="Center"
                        Padding="40,12" FontSize="18"
                        Background="#1565C0" Foreground="White"
                        Visibility="{Binding IsTextRevealed, Converter={StaticResource InvertBoolToVisibilityConverter}}" />

                <!-- Rating buttons (shown when revealed) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Visibility="{Binding IsTextRevealed, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="8,0">
                        <Button Content="نسيت"
                                Command="{Binding RateForgotCommand}"
                                Padding="24,12" FontSize="16"
                                Background="#C62828" Foreground="White" />
                        <TextBlock Text="(0)" FontSize="11" Foreground="#888"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"
                                   FlowDirection="LeftToRight" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <Button Content="صعب"
                                Command="{Binding RateHardCommand}"
                                Padding="24,12" FontSize="16"
                                Background="#E65100" Foreground="White" />
                        <TextBlock Text="(3)" FontSize="11" Foreground="#888"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"
                                   FlowDirection="LeftToRight" />
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <Button Content="سهل"
                                Command="{Binding RateEasyCommand}"
                                Padding="24,12" FontSize="16"
                                Background="#2E7D32" Foreground="White" />
                        <TextBlock Text="(5)" FontSize="11" Foreground="#888"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"
                                   FlowDirection="LeftToRight" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
