<UserControl x:Class="MatnMemorization.Presentation.Wpf.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MatnMemorization.Presentation.Wpf.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ImportViewModel}"
             FlowDirection="RightToLeft"
             FontFamily="Noto Naskh Arabic, Segoe UI, Arial">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="استيراد مستند" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" />

        <!-- File picker -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,8,0">
                <TextBlock Text="{Binding FilePath, FallbackValue='لم يُختَر ملف بعد'}"
                           FontSize="14" Foreground="#555" TextTrimming="CharacterEllipsis" />
            </Border>
            <Button Grid.Column="1"
                    Content="اختر ملفاً"
                    Command="{Binding PickFileCommand}"
                    Padding="16,8" FontSize="14"
                    IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}" />
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   FontSize="13" Foreground="#444"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}"
                   Margin="0,0,0,8" />

        <!-- Error -->
        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red" FontSize="13"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}"
                   Margin="0,0,0,8" />

        <!-- Progress bar -->
        <StackPanel Grid.Row="4" Margin="0,0,0,16"
                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="14" />
            <TextBlock Text="{Binding Progress, StringFormat={}{0}%}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Action buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Content="بدء التعرف الضوئي"
                    Command="{Binding StartOcrCommand}"
                    Padding="20,10" FontSize="15" Margin="0,0,12,0"
                    IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}" />
            <Button Content="إلغاء"
                    Command="{Binding CancelCommand}"
                    Padding="16,10" FontSize="14"
                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>
    </Grid>
</UserControl>
