<UserControl x:Class="MatnMemorization.Presentation.Wpf.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MatnMemorization.Presentation.Wpf.ViewModels"
             FlowDirection="RightToLeft"
             FontFamily="Noto Naskh Arabic, Segoe UI, Arial"
             d:DataContext="{d:DesignInstance vm:LibraryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="مكتبتي" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />

        <!-- Search + Add button -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14"
                     Padding="6,4"
                     Margin="0,0,8,0">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Tag" Value="ابحث بالعنوان أو الكاتب..." />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <Button Grid.Column="1"
                    Content="+ إضافة متن"
                    Command="{Binding OpenCreateDialogCommand}"
                    Padding="12,6" FontSize="14" />
        </Grid>

        <!-- Error message -->
        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}"
                   Margin="0,0,0,4" />

        <!-- Matn list -->
        <Border Grid.Row="3" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
            <ListBox ItemsSource="{Binding Matns}"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Author}" FontSize="13" Foreground="#666" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="فتح"
                                    Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Margin="4,0" Padding="8,4" />
                            <Button Grid.Column="2"
                                    Content="حذف"
                                    Command="{Binding DataContext.DeleteMatnCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Padding="8,4" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Loading indicator -->
        <TextBlock Grid.Row="4"
                   Text="جارٍ التحميل..."
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                   Margin="0,4,0,0" />

        <!-- Create dialog overlay -->
        <Grid Grid.RowSpan="5"
              Visibility="{Binding IsCreateDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#80000000">
            <Border Background="White" CornerRadius="8" Padding="24"
                    MaxWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="إضافة متن جديد" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />
                    <TextBlock Text="العنوان *" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15" Padding="6,4" Margin="0,0,0,10" />
                    <TextBlock Text="الكاتب" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewAuthor, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15" Padding="6,4" Margin="0,0,0,10" />
                    <TextBlock Text="التصنيف" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewCategory, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15" Padding="6,4" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="حفظ"
                                Command="{Binding ConfirmCreateCommand}"
                                Padding="16,8" Margin="0,0,8,0" />
                        <Button Content="إلغاء"
                                Command="{Binding CancelCreateCommand}"
                                Padding="16,8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
