<UserControl x:Class="MatnMemorization.Presentation.Wpf.Views.OcrReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MatnMemorization.Presentation.Wpf.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:OcrReviewViewModel}"
             FlowDirection="RightToLeft"
             FontFamily="Noto Naskh Arabic, Segoe UI, Arial">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + action buttons -->
        <Grid Grid.Row="0" Margin="12,12,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="مراجعة نتائج OCR" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="اعتماد الكل" Command="{Binding ApproveAllCommand}" Padding="12,6" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="اعتماد الصفحة" Command="{Binding ApprovePageCommand}" CommandParameter="{Binding SelectedPage}" Padding="12,6" Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="حفظ وإنشاء المتن" Command="{Binding OpenImportDialogCommand}" Padding="14,6" FontWeight="SemiBold" />
        </Grid>

        <!-- Error -->
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Red"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}"
                   Margin="12,0,12,4" />

        <!-- Main content: pages list + text editor -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Pages list -->
            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage}"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding PageNumber, StringFormat='صفحة {0}'}" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="✓" Foreground="Green" FontSize="14"
                                           Visibility="{Binding IsApproved, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Text editor -->
            <Grid Grid.Column="1" Margin="12,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding SelectedPage.PageNumber, StringFormat='تحرير الصفحة {0}'}"
                           FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"
                           Visibility="{Binding SelectedPage, Converter={StaticResource NullToCollapsedConverter}}" />
                <TextBox Grid.Row="1"
                         Text="{Binding SelectedPage.EditedText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="17"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Noto Naskh Arabic, Arial"
                         IsEnabled="{Binding SelectedPage, Converter={StaticResource NullToCollapsedConverter}}" />
            </Grid>
        </Grid>

        <!-- Bottom status bar -->
        <StatusBar Grid.Row="3" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding Pages.Count, StringFormat='عدد الصفحات: {0}'}" FontSize="12" />
            </StatusBarItem>
        </StatusBar>

        <!-- Import dialog overlay -->
        <Grid Grid.RowSpan="4"
              Visibility="{Binding IsImportDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#80000000">
            <Border Background="White" CornerRadius="8" Padding="28"
                    MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="إنشاء متن جديد" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />
                    <TextBlock Text="العنوان *" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15" Padding="6,4" Margin="0,0,0,10" />
                    <TextBlock Text="الكاتب" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewAuthor, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15" Padding="6,4" Margin="0,0,0,16" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}"
                               Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="حفظ"
                                Command="{Binding ConfirmImportCommand}"
                                IsEnabled="{Binding IsImporting, Converter={StaticResource InvertBoolConverter}}"
                                Padding="18,8" Margin="0,0,8,0" />
                        <Button Content="إلغاء"
                                Command="{Binding CancelImportCommand}"
                                Padding="14,8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
